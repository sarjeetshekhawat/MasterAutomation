# ─── Python artifacts ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
.eggs/

# ─── Testing ────────────────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml

# ─── Virtual environments ───────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ─── Secrets and local configuration ────────────────────────────────
.env
.env.*
!.env.example

# ─── Application input / output data ───────────────────────────────
# Actual consumer datasets, hierarchy reports, and generated output
# workbooks must never be committed. They contain sensitive business
# data and can be very large.
input/
output/
*.output.xlsx

# ─── Temporary and generated files ──────────────────────────────────
*.tmp
*.bak
*.swp
~$*

# ─── Operating system artifacts ─────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ─── IDE and editor files ──────────────────────────────────────────
.vscode/
.idea/
*.code-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ─── Gemini / Antigravity local state ──────────────────────────────
.gemini/
.agents/
